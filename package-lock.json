{
  "name": "fortune-blast-system",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fortune-blast-system",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22",
        "npm": ">=10"
      }
    },
    "apps/api": {
      "name": "@fortuneblast/api",
      "version": "1.0.0"
    },
    "apps/mobile": {
      "name": "@fortuneblast/mobile",
      "version": "1.0.0"
    },
    "node_modules/@fortuneblast/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@fortuneblast/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@fortuneblast/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@fortuneblast/shared",
      "version": "1.0.0"
    }
  }
}
